<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:local="clr-namespace:MurisHaseljic472"
            x:Class="MurisHaseljic472.MainPage"
            BackgroundColor="#F8F9FA">

    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="15">

            <FlexLayout JustifyContent="SpaceBetween" AlignItems="Center" HeightRequest="60">
                <Image Source="logo.png" WidthRequest="50" HeightRequest="50" Aspect="AspectFit"/>
                <Label Text="Art Institute of Chicago" FontSize="Medium" FontAttributes="Bold" TextColor="Black" VerticalOptions="Center"/>
                <Image Source="https://raw.githubusercontent.com/Art-Institute-of-Chicago/template/master/aic-logo.gif" 
                       WidthRequest="50" HeightRequest="50" Aspect="AspectFit"/>
            </FlexLayout>

            <StackLayout>
                <Frame Padding="0" BorderColor="#CCCCCC" CornerRadius="8" HasShadow="False">
                    <Grid ColumnDefinitions="*,*,Auto" Padding="5" ColumnSpacing="5">
                        <Entry x:Name="PageNumberEntry" Placeholder="Page Number" TextColor="Black" PlaceholderColor="Gray" Keyboard="Numeric" Grid.Column="0"/>
                        <Picker x:Name="PageSizePicker" Title="Size" TitleColor="Gray" TextColor="Black" Grid.Column="1">
                            <Picker.Items>
                                <x:String>5</x:String>
                                <x:String>10</x:String>
                                <x:String>20</x:String>
                                <x:String>50</x:String>
                                <x:String>100</x:String>
                            </Picker.Items>
                        </Picker>
                        <Button Text="Search" Clicked="OnSearchClicked" BackgroundColor="#6200EE" TextColor="White" Grid.Column="2"/>
                    </Grid>
                </Frame>
            </StackLayout>

            <VerticalStackLayout x:Name="EmptyView" HorizontalOptions="Center" VerticalOptions="Center" Padding="50" Spacing="10">
                <Label Text="No available artworks" FontSize="18" FontAttributes="Bold" TextColor="Black" HorizontalTextAlignment="Center"/>
                <Label Text="Try selecting page number and size to get started" FontSize="14" TextColor="Gray" HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="ArtworksContainer" BindableLayout.ItemsSource="{Binding Artworks}" Spacing="12">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="local:ArtworkData">
                        <Frame Padding="20" CornerRadius="16" HasShadow="True" BorderColor="#E0E0E0" BackgroundColor="White">
                            <FlexLayout JustifyContent="SpaceBetween" AlignItems="Center">

                                <VerticalStackLayout WidthRequest="250" Spacing="4">
                                    <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" TextColor="Black"/>
                                    <Label Text="{Binding DateDisplay}" FontSize="13" TextColor="Gray"/>
                                    <Label Text="{Binding PlaceOfOrigin}" FontSize="13" TextColor="Gray"/>
                                    <Label Text="{Binding MediumDisplay}" FontSize="13" TextColor="#444444"/>

                                    <HorizontalStackLayout Spacing="6" Margin="0,5,0,0">
                                        <Frame Padding="6" CornerRadius="10" BackgroundColor="#F2F2F2" HasShadow="False" BorderColor="Transparent">
                                            <Label Text="{Binding ClassificationTitle}" FontSize="11" TextColor="Black"/>
                                        </Frame>
                                        <Frame Padding="6" CornerRadius="10" BackgroundColor="#F2F2F2" HasShadow="False" BorderColor="Transparent">
                                            <Label Text="{Binding FirstMaterial}" FontSize="11" TextColor="Black"/>
                                        </Frame>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <Button Text="Preview" Clicked="OnPreviewClicked" CommandParameter="{Binding .}" 
                                        VerticalOptions="Center" BackgroundColor="#6200EE" TextColor="White"/>
                            </FlexLayout>
                        </Frame>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>